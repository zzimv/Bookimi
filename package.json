{
  "name": "bookimi",
  "version": "0.1.0",
  "private": true,
  "description": "БУКИМИ — персонализированные детские книги по фото ребёнка",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "worker": "tsx src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "check:bundle-secrets": "node scripts/check-bundle-secrets.mjs",
    "db:generate": "prisma generate",
    "db:demo": "tsx scripts/seed-demo.ts",
    "db:local": "node scripts/dev-db.mjs",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@fontsource/manrope": "^5.1.0",
    "@fontsource/nunito": "^5.1.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.10.0",
    "next": "^15.5.0",
    "nodemailer": "^10.2.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pg-boss": "^10.1.0",
    "playwright-core": "^1.64.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tsx": "^4.19.0",
    "web-vitals": "^6.2.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "embedded-postgres": "^16.9.0-beta.15",
    "prisma": "^6.10.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.5"
  }
}
