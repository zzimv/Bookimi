# ── БУКИМИ: переменные окружения ──
# Скопируйте в .env на сервере и выставьте права: chmod 600 .env
# Имена переменных фиксированы — на них ссылается инструкция по деплою.

# Домен
DOMAIN=bookimi.ru
# Дополнительные домены → 301 на DOMAIN (через запятую, кириллица — в punycode)
EXTRA_DOMAINS=www.bookimi.ru

# Образ (CI подставляет IMAGE_TAG)
IMAGE=ghcr.io/OWNER/bookimi
IMAGE_TAG=latest

# PostgreSQL 16
POSTGRES_USER=bookimi
POSTGRES_PASSWORD=
POSTGRES_DB=bookimi

# Yandex Object Storage
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_PHOTOS=bookimi-photos
S3_BUCKET_BOOKS=bookimi-books
S3_BUCKET_BACKUPS=bookimi-backups

# Оплата: sbp_qr | transfer | yookassa | none (способы также включаются в админке)
PAYMENT_PROVIDER=none
PAYMENT_SBP_API_URL=
PAYMENT_SBP_MERCHANT_ID=
PAYMENT_SBP_API_KEY=
PAYMENT_SBP_WEBHOOK_SECRET=
PAYMENT_TRANSFER_PHONE=
PAYMENT_TRANSFER_CARD=
PAYMENT_YOOKASSA_SHOP_ID=
PAYMENT_YOOKASSA_SECRET_KEY=

# «Мой налог» (чеки НПД через API партнёров ФНС, если платёжный сервис не выдаёт их сам)
NPD_PROVIDER=
NPD_API_URL=
NPD_API_KEY=
NPD_INN=

# Доставка
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_TEST_MODE=true
POCHTA_ACCESS_TOKEN=
POCHTA_LOGIN=
POCHTA_PASSWORD=
YANDEX_DELIVERY_TOKEN=
YANDEX_DELIVERY_PLATFORM_ID=

# Аналитика
YANDEX_METRIKA_ID=
VARIOQUB_ID=

# Капча
YANDEX_SMARTCAPTCHA_CLIENT_KEY=
YANDEX_SMARTCAPTCHA_SERVER_KEY=

# Уведомления
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
MAX_BOT_TOKEN=
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER_URL=
WHATSAPP_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="БУКИМИ <hello@bookimi.ru>"

# ИИ: текст (yandexgpt | gigachat)
TEXT_PROVIDER=yandexgpt
YANDEX_CLOUD_FOLDER_ID=
YANDEX_CLOUD_API_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=

# ИИ: изображения (qwen-image-edit | kandinsky)
IMAGE_PROVIDER=qwen-image-edit
FOREIGN_IMAGE_PROVIDER=false
GPU_CLOUD=selectel
GPU_CLOUD_API_TOKEN=
GPU_CLOUD_PROJECT_ID=
GPU_INSTANCE_FLAVOR=
GPU_IDLE_MINUTES=10
GPU_INFERENCE_TOKEN=
SBER_KANDINSKY_API_KEY=

# Синтез речи (speechkit | salutespeech)
TTS_PROVIDER=speechkit
SALUTESPEECH_CLIENT_ID=
SALUTESPEECH_CLIENT_SECRET=

# Сессии
SESSION_SECRET=

# SMS для входа по телефону (smsc | smsru); без ключа вход только по email
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=Bookimi

# Демо-режим: коды входа показываются на экране, оплата «понарошку». В продакшне — 0!
DEMO_MODE=0
# Путь к Chromium для PDF (в Docker ставится пакет chromium)
CHROMIUM_PATH=/usr/bin/chromium
# Хранилище: s3 (Yandex Object Storage) | local (папка ./storage, для разработки)
STORAGE_DRIVER=s3
# Адрес сервера генерации на GPU (tools/gpu-server) и ключ доступа к нему
GPU_SERVER_URL=
GPU_INSTANCE_ID=

# Дополнительно
TELEGRAM_BOT_USERNAME=          # имя бота без @ — для кнопки «Подключить Telegram»
TELEGRAM_WEBHOOK_SECRET=        # secret_token вебхука /api/telegram/webhook
TELEGRAM_SUPPORT_URL=           # ссылка на чат поддержки в Telegram
MAX_SUPPORT_URL=                # ссылка на чат поддержки в MAX
YANDEX_MAPS_REVIEW_URL=         # ссылка «оставить отзыв» на Яндекс Картах
INDEXNOW_KEY=                   # ключ IndexNow для Яндекса
YANDEXGPT_MODEL=yandexgpt/latest
YANDEXGPT_RUB_PER_1K=1.2        # цена 1000 токенов для учёта расходов (сверить с прайсом)
SPEECHKIT_RUB_PER_1M=1320       # цена 1 млн символов синтеза (сверить с прайсом)
YC_SA_KEY_JSON=                 # авторизованный ключ сервисного аккаунта (включение/выключение GPU-ВМ)
CDEK_FROM_CITY_CODE=44          # код города отправки (44 — Москва)
CDEK_SHIPMENT_POINT=            # код ПВЗ отправки СДЭК
PRINT_API_KEY=                  # ключ API типографии, если передача заказов по API
LOCAL_STORAGE_DIR=              # для STORAGE_DRIVER=local
